# ============================================================
# LLM 配置(三套命名,按优先级:VLLM_* > LLM_* > ARK_*)
# 只需配置其中一套即可。
# ============================================================

# ---- 方式 A:学院服务器本地 Qwen3-8B(vLLM,服务器部署用这套)----
# 阿里云服务器与千问机同内网时,填千问机的内网地址
VLLM_BASE_URL=http://127.0.0.1:9002/v1
VLLM_MODEL_NAME=Qwen3-8B
VLLM_API_KEY=sk-anything
VLLM_TEMPERATURE=0.0
# vLLM 较新版支持 json_object;若调用报 response_format 不支持,改为 false
LLM_JSON_MODE=true

# ---- 方式 B:火山方舟 Doubao(本地开发/演示用,二选一)----
# ARK_API_KEY=put-your-ark-api-key-here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-2-0-lite-260215

# ============================================================
# 数据库(默认 SQLite,无需改)
# ============================================================
DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# 可选:加速 bge-m3 等模型下载(国内)
# ============================================================
HF_ENDPOINT=https://hf-mirror.com
