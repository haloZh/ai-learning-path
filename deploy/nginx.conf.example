# Nginx 反向代理配置示例(可选)
#
# 适用场景:想用 80 端口(免端口号)访问,或后续加 HTTPS。
# 先 HTTP+IP 阶段可不用 Nginx,直接 uvicorn 监听 8000 即可。
#
# 安装:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/learning-path
#   sudo ln -s /etc/nginx/sites-available/learning-path /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   阿里云安全组放行 80 端口

server {
    listen 80;
    server_name _;   # 有域名改成域名;无域名用 _ 匹配 IP 访问

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 诊断/交互走 LLM 较慢,放宽超时到 3 分钟
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

# ── 后续加 HTTPS(有域名时)──
# 用 certbot 自动签发 Let's Encrypt 证书:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d 你的域名
# certbot 会自动改写本文件加上 443 + 证书路径。
